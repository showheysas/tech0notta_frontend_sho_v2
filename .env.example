# Backend API URL
# For local backend: http://localhost:8000
# For Azure backend: https://app-002-tech0notta-backend-dev.azurewebsites.net
NEXT_PUBLIC_API_URL=https://app-002-tech0notta-backend-dev.azurewebsites.net

# Azure AD (Microsoft Entra ID) 認証設定
AUTH_MICROSOFT_ENTRA_ID_ID=your-client-id-here
AUTH_MICROSOFT_ENTRA_ID_SECRET=your-client-secret-here
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=your-tenant-id-here

# Auth.js セッション暗号化キー
AUTH_SECRET=generate-a-random-key-here

# このフロントエンドのURL
NEXTAUTH_URL=http://localhost:3001
AUTH_TRUST_HOST=true
